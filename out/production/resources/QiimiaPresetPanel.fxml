                        <Insets left="7.0" right="7.0" />
                     </GridPane.margin>
                     <tooltip>
                        <Tooltip text="Pre-processing and segmentation script (default path: PROJECT/scripts)" />
                     </tooltip>
                  </ComboBox>
                  <ComboBox fx:id="presetComboBox" layoutX="17.0" layoutY="11.0" prefHeight="26.0" prefWidth="250.0" promptText="QiimiaQuant Preset" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="BOTTOM">
                     <GridPane.margin>
                        <Insets left="7.0" right="7.0" />
                     </GridPane.margin>
                     <tooltip>
                        <Tooltip text="PathObject source of compartments" />
                     </tooltip>
                  </ComboBox>
                  <Button fx:id="editScriptButton" mnemonicParsing="false" text="Edit" visible="false" GridPane.columnIndex="1">
                     <tooltip>
                        <Tooltip />
                     </tooltip>
                  </Button>
                  <Button fx:id="editPresetButton" mnemonicParsing="false" prefWidth="50.0" text="Edit" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="BOTTOM">
                     <tooltip>
                        <Tooltip text="Edit QiimiaQuant Preset settings inside Quant panel..." />
                     </tooltip>
                  </Button>
               </children>
            </GridPane>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="150.0" spacing="25.0">
               <children>
                  <Button fx:id="startQuantButton" disable="true" mnemonicParsing="false" text="Start Quantify" />
                  <Button fx:id="cancelQuantButton" disable="true" mnemonicParsing="false" text="Cancel" />
               </children>
            </HBox>
            <VBox alignment="TOP_CENTER" spacing="3.0">
               <children>
                  <Label fx:id="progressLabel" alignment="BOTTOM_CENTER" minHeight="25.0" prefHeight="25.0">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <ProgressBar fx:id="quantProgressBar" minHeight="18.0" prefHeight="20.0" prefWidth="280.0" progress="0.0" />
                  <Button fx:id="exportMeasButton" alignment="CENTER" mnemonicParsing="false" text="Export Measurements" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
         </padding>
      </VBox>
