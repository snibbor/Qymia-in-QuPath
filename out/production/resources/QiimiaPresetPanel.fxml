<AnchorPane maxHeight="400.0" maxWidth="500.0" minHeight="300.0" prefHeight="300.0" prefWidth="325.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="qupath.extension.qiimia.QiimiaPresetPanelController">
   <children>
      <MenuBar layoutY="-36.0" prefHeight="25.0" prefWidth="323.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <menus>
            <Menu mnemonicParsing="false" text="File">
              <items>
                <MenuItem fx:id="exportMeasMenuItem" mnemonicParsing="false" text="Export Measurements" />
                  <MenuItem fx:id="exportMaskMenuItem" mnemonicParsing="false" text="Export Masks" visible="false" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem fx:id="runForProjectMenuItem" mnemonicParsing="false" text="Run for project..." />
              </items>
            </Menu>
            <Menu fx:id="settingsMenu" mnemonicParsing="false" text="Settings">
               <items>
                  <CheckMenuItem fx:id="verboseMeasuresMenuItem" mnemonicParsing="false" selected="true" text="Verbose measurements" visible="false" />
                  <SeparatorMenuItem mnemonicParsing="false" visible="false" />
                  <CheckMenuItem fx:id="normalizeMenuItem" mnemonicParsing="false" selected="true" text="Normalize Qiimia Scores" visible="false" />
                  <CheckMenuItem fx:id="rescaleMenuItem" mnemonicParsing="false" text="Rescale previously normalized data (old PM2000)" visible="false" />
                  <SeparatorMenuItem mnemonicParsing="false" visible="false" />
                  <CheckMenuItem fx:id="deleteTilesMenuItem" mnemonicParsing="false" selected="true" text="Delete tiles before run" visible="false" />
                  <CheckMenuItem fx:id="tileUnitIsMicronsMenuItem" mnemonicParsing="false" text="Tile unit in microns" visible="false" />
                  <SeparatorMenuItem mnemonicParsing="false" visible="false" />
                  <CheckMenuItem fx:id="convertMeasMenuItem" mnemonicParsing="false" text="Convert measurements (using regress. meas. convs.)" />
                  <MenuItem fx:id="selectBatchMapMenuItem" mnemonicParsing="false" text="Select batch map file" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem fx:id="selectSyncMapMenuItem" mnemonicParsing="false" text="Select sync map file" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem fx:id="advancedSettingsMenuItem" mnemonicParsing="false" text="Advanced settings..." visible="false" />
                  <MenuItem fx:id="selectScriptDirMenuItem" mnemonicParsing="false" text="Select script directory" />
                  <MenuItem fx:id="selectPresetDirMenuItem" mnemonicParsing="false" text="Select quant preset directory" />
               </items>
            </Menu>
            <Menu fx:id="navigateMenu" mnemonicParsing="false" text="Navigate">
               <items>
                  <MenuItem fx:id="standardCurveMenuItem" mnemonicParsing="false" text="TMA standard curve..." />
                  <MenuItem fx:id="comparisonMenuItem" mnemonicParsing="false" text="Comparison..." />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem fx:id="switchQuantMenuItem" mnemonicParsing="false" text="Switch to Quant Panel..." />
               </items>
            </Menu>
          <Menu fx:id="helpMenu" mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="300.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
         <children>
            <GridPane alignment="TOP_CENTER" maxWidth="340.0" minHeight="60.0" prefHeight="80.0" prefWidth="300.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.3999755859375" minWidth="10.0" prefWidth="242.19998779296876" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="151.20001220703128" minWidth="10.0" prefWidth="68.60001220703126" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
