                                    <VBox>
                                       <children>
                                          <Label text="Ignore Classes">
                                             <tooltip>
                                                <Tooltip text="Select compartments (PathClass)" />
                                             </tooltip>
                                          </Label>
                                          <ScrollPane fx:id="ignoreScrollPane" fitToHeight="true" fitToWidth="true" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                             <content>
                                                <ListView fx:id="ignoreListView" />
                                             </content>
                                          </ScrollPane>
                                       </children>
                                    </VBox>
                                    <VBox>
                                       <children>
