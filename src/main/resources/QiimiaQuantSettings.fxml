                                                <Tooltip text="Select the channels/transforms that are targets to quantify" />
                                             </tooltip>
                                          </Label>
                                          <ScrollPane fx:id="roiScrollPane" fitToHeight="true" fitToWidth="true" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                             <content>
                                                <ListView fx:id="roiListView" />
                                             </content>
                                          </ScrollPane>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <GridPane alignment="TOP_CENTER" maxWidth="340.0" minHeight="90.0" prefHeight="60.0" prefWidth="323.0">
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="165.0" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.0" minWidth="10.0" prefWidth="100.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.0" minWidth="10.0" prefWidth="120.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.0" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label text="Ref. NA:">
                                       <padding>
                                          <Insets left="3.0" />
                                       </padding>
                                    </Label>
                                    <Label text="Ref. Mag:" GridPane.rowIndex="1">
                                       <padding>
                                          <Insets left="3.0" />
                                       </padding>
                                    </Label>
                                    <TextField fx:id="refNATextField" prefWidth="50.0" GridPane.columnIndex="1" />
                                    <TextField fx:id="refMagTextField" prefWidth="50.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Work. NA:" GridPane.columnIndex="2">
                                       <padding>
                                          <Insets left="6.0" />
                                       </padding>
                                    </Label>
                                    <Label text="Work. Mag:" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                       <padding>
                                          <Insets left="6.0" />
                                       </padding>
                                    </Label>
                                    <TextField fx:id="workNATextField" prefWidth="50.0" GridPane.columnIndex="3" />
                                    <TextField fx:id="workMagTextField" prefWidth="50.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
